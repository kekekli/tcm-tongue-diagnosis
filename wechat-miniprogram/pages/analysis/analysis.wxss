/* pages/analysis/analysis.wxss */

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.upload-area {
  text-align: center;
  padding: 80rpx 40rpx;
  border: 4rpx dashed #ddd;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
  background: #fafafa;
}

.upload-icon {
  font-size: 120rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 26rpx;
  color: #666;
}

.camera-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.tips {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.image-preview {
  text-align: center;
  margin-bottom: 40rpx;
}

.preview-image {
  width: 100%;
  max-height: 600rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}

.preview-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.analyzing-card {
  text-align: center;
}

.analyzing-content {
  margin-bottom: 40rpx;
}

.analyzing-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.analyzing-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #667eea;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
}

.analyzing-image {
  margin-top: 40rpx;
}

.small-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin: 0 auto;
  display: block;
}

.error {
  text-align: center;
  padding: 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: #721c24;
  margin-bottom: 32rpx;
}

.success-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.success-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #155724;
  text-align: center;
  margin-bottom: 40rpx;
}