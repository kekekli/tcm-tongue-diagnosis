/* pages/result/result.wxss */

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
}

.result-section {
  margin-bottom: 32rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.constitution-section {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  color: white;
  margin-top: 32rpx;
}

.constitution-title {
  font-size: 28rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.constitution-type {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.constitution-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

.advice-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #555;
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 8rpx solid #667eea;
}

.product-list {
  margin-top: 20rpx;
}

.product-card {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.2s ease;
}

.product-card:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.product-card:last-child {
  margin-bottom: 0;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
}

.product-reason {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.product-rating {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.rating-stars {
  color: #ffc107;
  margin-right: 8rpx;
}

.rating-text {
  color: #999;
}

.notice-list {
  margin-top: 20rpx;
}

.notice-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.action-buttons {
  margin: 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}